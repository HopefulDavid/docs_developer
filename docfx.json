{
  "build": {
    "template": [
      "default",
      "modern",
      "templates/material"
    ],
    "content": [
      {
        "files": [
          "index.md",
          "**/*.{md,yml}"
        ],
        "exclude": [
          ".agents/**",
          ".ai/**",
          ".codex/**",
          ".config/**",
          ".git/**",
          ".github/**",
          ".idea/**",
          "_site/**",
          "docs/**",
          "node_modules/**",
          "private/**",
          "scripts/**",
          "templates/**",
          "tests/**",
          "tools/**",
          "AGENTS.md",
          "AGENTS.override.md",
          "**/AGENTS.md",
          "**/AGENTS.override.md",
          "CLAUDE.md",
          "GEMINI.md",
          "README.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
          "pdf/**"
        ]
      }
    ],
    "output": "_site",
    "globalMetadata": {
      "_appName": "Vývojář",
      "_appTitle": "Vývojář",
      "_enableSearch": true,
      "_lang": "cs",
      "_disableContribution": true,
      "pdf": false
    },
    "markdown": {
      "max_header_level": 7
    }
  }
}
